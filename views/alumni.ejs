<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alumni Directory - Sukkur IBA</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-light min-vh-100 d-flex flex-column">

    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/"><i class="fa-solid fa-graduation-cap me-2"></i>Sukkur IBA Alumni</a>
            <div>
                <a href="/" class="btn btn-outline-light btn-sm me-2"><i class="fa-solid fa-house me-1"></i> Home</a>
                <a href="/profile" class="btn btn-outline-light btn-sm me-2"><i class="fa-solid fa-user me-1"></i> Profile</a>
                <a href="/logout" class="btn btn-danger btn-sm"><i class="fa-solid fa-right-from-bracket me-1"></i> Logout</a>
            </div>
        </div>
    </nav>

    <!-- Main Directory Content -->
    <div class="container my-4">
        <div class="text-center mb-4">
            <h2 class="fw-bold text-dark">Alumni Directory</h2>
            <p class="text-muted">Connect with graduates of Sukkur IBA University</p>
            
            <!-- CREATE: Button to trigger Add Alumni Modal -->
            <button class="btn btn-success mt-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#addAlumniModal">
                <i class="fa-solid fa-user-plus me-1"></i> Add New Alumni
            </button>
        </div>

        <!-- Search Bar -->
        <div class="row justify-content-center mb-5">
            <div class="col-md-8">
                <form action="/alumni" method="GET" class="d-flex gap-2">
                    <input type="text" name="search" class="form-control form-control-lg shadow-sm" placeholder="Search by Name, Department, or Organization..." value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
                    <button type="submit" class="btn btn-primary btn-lg px-4 shadow-sm">
                        <i class="fa-solid fa-magnifying-glass me-1"></i> Search
                    </button>
                </form>
            </div>
        </div>

        <!-- Alumni Cards Grid -->
        <div class="row g-4">
            <% if (alumniList && alumniList.length > 0) { %>
                <% alumniList.forEach(alumni => { %>
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm border-0 rounded-4 text-center p-3 position-relative">
                            
                            <!-- UPDATE & DELETE Actions Dropdown / Buttons Top-Right -->
                            <div class="position-absolute top-0 end-0 m-3">
                                <button class="btn btn-sm btn-outline-secondary rounded-circle me-1" data-bs-toggle="modal" data-bs-target="#editAlumniModal<%= alumni.id %>" title="Edit">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </button>
                                <form action="/alumni/delete/<%= alumni.id %>" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this alumni?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle" title="Delete">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </div>

                            <div class="card-body d-flex flex-column align-items-center mt-2">
                                <div class="bg-light text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px; font-size: 1.8rem;">
                                    <i class="fa-solid fa-user-graduate"></i>
                                </div>
                                <h5 class="card-title fw-bold text-dark mb-1"><%= alumni.full_name %></h5>
                                <p class="text-muted small mb-3"><%= alumni.email %></p>

                                <div class="mb-3">
                                    <span class="badge bg-primary-subtle text-primary fw-semibold px-3 py-2 me-1">
                                        Batch: <%= alumni.batch ? alumni.batch : 'N/A' %>
                                    </span>
                                    <span class="badge bg-secondary-subtle text-secondary fw-semibold px-3 py-2">
                                        <%= alumni.department ? alumni.department : 'N/A' %>
                                    </span>
                                </div>

                                <p class="text-muted small mt-auto mb-0">
                                    <i class="fa-solid fa-building me-1"></i>
                                    <%= (alumni.organization && alumni.organization !== 'null') ? alumni.organization : 'Not Specified' %>
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- UPDATE Modal for each Alumni -->
                    <div class="modal fade" id="editAlumniModal<%= alumni.id %>" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content text-start">
                                <div class="modal-header">
                                    <h5 class="modal-title fw-bold">Edit Alumni Record</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <form action="/alumni/edit/<%= alumni.id %>" method="POST">
                                    <div class="modal-body">
                                        <div class="mb-3">
                                            <label class="form-label">Full Name</label>
                                            <input type="text" name="full_name" class="form-control" value="<%= alumni.full_name %>" required>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Email</label>
                                            <input type="email" name="email" class="form-control" value="<%= alumni.email %>" required>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Batch</label>
                                            <input type="text" name="batch" class="form-control" value="<%= alumni.batch %>">
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Department</label>
                                            <input type="text" name="department" class="form-control" value="<%= alumni.department %>">
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Organization</label>
                                            <input type="text" name="organization" class="form-control" value="<%= alumni.organization %>">
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-primary">Save Changes</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="col-12 text-center py-5">
                    <h5 class="text-muted">No alumni found matching your search.</h5>
                </div>
            <% } %>
        </div>
    </div>

    <!-- CREATE Modal: Add New Alumni -->
    <div class="modal fade" id="addAlumniModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content text-start">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Add New Alumni</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form action="/alumni/add" method="POST">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Full Name</label>
                            <input type="text" name="full_name" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input type="email" name="email" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Batch</label>
                            <input type="text" name="batch" class="form-control">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Department</label>
                            <input type="text" name="department" class="form-control">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Organization</label>
                            <input type="text" name="organization" class="form-control">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success">Add Alumni</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>