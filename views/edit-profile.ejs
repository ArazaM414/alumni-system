<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Profile - Sukkur IBA Alumni</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-light min-vh-100 d-flex flex-column">

    <!-- Top Navbar -->
    <nav class="navbar navbar-dark bg-primary shadow-sm mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">
                <i class="fa-solid fa-graduation-cap me-2"></i>Sukkur IBA Alumni
            </a>
            <a href="/profile" class="btn btn-outline-light btn-sm">Cancel</a>
        </div>
    </nav>

    <!-- Main Edit Form Card -->
    <div class="container my-auto py-4">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-6">
                <div class="card shadow-lg border-0 rounded-4">
                    <div class="card-body p-4 p-sm-5">
                        <h3 class="card-title text-center fw-bold mb-4">Edit Profile Details</h3>

                        <% if (locals.error) { %>
                            <div class="alert alert-danger" role="alert">
                                <%= error %>
                            </div>
                        <% } %>

                        <form action="/profile/edit" method="POST">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Full Name</label>
                                <input type="text" name="full_name" class="form-control" value="<%= user.full_name %>" required>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Batch Year</label>
                                    <input type="text" name="batch" class="form-control" value="<%= user.batch || '' %>">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Department</label>
                                    <input type="text" name="department" class="form-control" value="<%= user.department || '' %>">
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-semibold">Organization / Company</label>
                                <input type="text" name="organization" class="form-control" value="<%= user.organization || '' %>">
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary w-100 fw-bold shadow-sm">Save Changes</button>
                                <a href="/profile" class="btn btn-outline-secondary w-100 fw-semibold">Cancel</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>