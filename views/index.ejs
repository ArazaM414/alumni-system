<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sukkur IBA - AlumniConnect</title>
    <!-- Bootstrap 5 CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-light min-vh-100 d-flex flex-column">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/"><i class="fa-solid fa-graduation-cap me-2"></i>Sukkur IBA Alumni</a>
            <div>
                <a href="/login" class="btn btn-outline-light me-2">Login</a>
                <a href="/register" class="btn btn-light text-primary fw-semibold">Register</a>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <div class="container my-auto py-5 text-center">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <h1 class="display-4 fw-bold text-dark mb-3">Connect with Sukkur IBA University</h1>
                <p class="lead text-muted mb-4">Join the official professional network for Sukkur IBA graduates, stay connected with campus updates, and network with fellow alumni.</p>
                <div class="d-flex justify-content-center gap-3">
                    <a href="/register" class="btn btn-primary btn-lg px-4 fw-semibold shadow-sm">Get Started</a>
                    <a href="/login" class="btn btn-outline-secondary btn-lg px-4 fw-semibold">Sign In</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>