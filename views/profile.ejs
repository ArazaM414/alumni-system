<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Profile - Sukkur IBA Alumni</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-light min-vh-100 d-flex flex-column">

    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/"><i class="fa-solid fa-graduation-cap me-2"></i>Sukkur IBA Alumni</a>
            <div>
                <a href="/" class="btn btn-outline-light btn-sm me-2"><i class="fa-solid fa-house me-1"></i> Home</a>
                <a href="/alumni" class="btn btn-outline-light btn-sm me-2"><i class="fa-solid fa-users me-1"></i> Directory</a>
                <a href="/logout" class="btn btn-danger btn-sm"><i class="fa-solid fa-right-from-bracket me-1"></i> Logout</a>
            </div>
        </div>
    </nav>

    <!-- Main Profile Card -->
    <div class="container my-auto py-4">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                    <div class="bg-primary text-white text-center py-4 px-3">
                        <div class="bg-white text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-2 shadow" style="width: 80px; height: 80px; font-size: 2rem;">
                            <i class="fa-solid fa-user"></i>
                        </div>
                        <h3 class="fw-bold mb-0"><%= user && user.full_name ? user.full_name : 'User Profile' %></h3>
                        <p class="text-white-50 mb-0"><%= user && user.email ? user.email : '' %></p>
                    </div>

                    <div class="card-body p-4">
                        <ul class="list-group list-group-flush mb-4">
                            <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                                <span class="fw-semibold text-muted"><i class="fa-solid fa-calendar-days text-primary me-2"></i>Batch</span>
                                <span class="fw-bold text-dark"><%= (user && user.batch) ? user.batch : 'N/A' %></span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                                <span class="fw-semibold text-muted"><i class="fa-solid fa-graduation-cap text-primary me-2"></i>Department</span>
                                <span class="fw-bold text-dark"><%= (user && user.department) ? user.department : 'N/A' %></span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                                <span class="fw-semibold text-muted"><i class="fa-solid fa-briefcase text-primary me-2"></i>Organization</span>
                                <span class="fw-bold text-dark"><%= (user && user.organization) ? user.organization : 'N/A' %></span>
                            </li>
                        </ul>

                        <!-- Action Buttons -->
                        <div class="d-flex gap-2">
                            <a href="/profile/edit" class="btn btn-primary w-100 fw-semibold">
                                <i class="fa-solid fa-pen-to-square me-1"></i> Edit Profile
                            </a>
                            <a href="/" class="btn btn-outline-secondary w-100 fw-semibold">
                                <i class="fa-solid fa-arrow-left me-1"></i> Back to Home
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>